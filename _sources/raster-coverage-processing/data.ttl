ospd:GA026 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA026> ;
    dcterms:source <https://gdal.org/en/stable/programs/gdal_raster_proximity.html> ;
    owl:versionInfo "3" ;
    skos:broader ospd:GA032 ;
    skos:definition "Calculates the shortest distance from each raster cell to the nearest input feature, such as a stream or other vector or raster feature."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Distance-to-feature calculation"@en ;
    skos:related ospd:GA025,
        ospd:GA028 ;
    prov:qualifiedAttribution [ prov:agent <https://hartis.org> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ] .

ospd:ZonalStatistics a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://example.org/ospd/process-types/ZonalStatistics> ;
    rdfs:seeAlso <https://example.org/ospd/process-types/zonal-statistics> ;
    skos:closeMatch ospd:GA027 ;
    skos:definition "Aggregates a gridded source per zone, skipping nodata cells."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Zonal statistics"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> .

ospd:GA027 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA027> ;
    dcterms:source <https://grass.osgeo.org/grass-stable/manuals/r.stats.zonal.html> ;
    owl:versionInfo "3" ;
    skos:broader ospd:GA032 ;
    skos:definition "Calculates summary statistics, such as mean, median, minimum or maximum, for raster cells within each input polygon or grid zone."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Zonal raster statistics"@en ;
    skos:related ospd:GA028,
        ospd:GA036 ;
    prov:qualifiedAttribution [ prov:agent <https://hartis.org> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ] .

ospd:GA028 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA028> ;
    dcterms:source <https://grass.osgeo.org/grass-stable/manuals/v.what.rast.html> ;
    owl:versionInfo "3" ;
    skos:broader ospd:GA032 ;
    skos:definition "Extracts the value of an input raster, or a defined neighbourhood of raster cells, at each input point location."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Raster sampling at points"@en ;
    skos:related ospd:GA026,
        ospd:GA027 ;
    prov:qualifiedAttribution [ prov:agent <https://hartis.org> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ] .

ospd:otsu-thresholding a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/otsu-thresholding> ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Divides the cells of a single-band raster into two classes at the threshold computed from the histogram of the cell values by Otsu's method, which maximises the variance between the two classes, and returns the cells of the upper class as a binary mask."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Otsu thresholding"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> .

ospd:raster-band-math-multiband a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/raster-band-math-multiband> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Evaluates a user-supplied, possibly vector-valued mathematical expression per pixel across one or more input rasters, producing an output raster with one or more bands."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Raster band math (multi-band output)"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> .

ospd:raster-crop a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/raster-crop> ;
    dcterms:source [ ] ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Extracts the pixels of a raster coverage that fall within a region of interest."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Raster crop"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> .

ospd:raster-extent a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/raster-extent> ;
    dcterms:source [ ] ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Computes the bounding envelope of a raster coverage, as a vector polygon."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Raster extent"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> .

ospd:raster-format-conversion a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/raster-format-conversion> ;
    dcterms:source [ ] ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Re-encodes a raster coverage into another raster format, without altering its content."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Raster format conversion"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> .

ospd:raster-rendering a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/raster-rendering> ;
    dcterms:source [ ] ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Depicts a raster as an image for viewing, giving each cell a colour from a colour map that associates values, or classes of values, with colours."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Raster rendering"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> .

ospd:raster-resampling a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/raster-resampling> ;
    dcterms:source [ ] ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Changes the cell size of a raster coverage, or its number of cells along each axis, over the same extent and in the same coordinate reference system, computing each new cell value from the input cells by an interpolation method."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Raster resampling"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> .

ospd:GA008 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-10-09"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA008> ;
    rdfs:seeAlso <https://hirondelle.crim.ca/weaver/processes/calculate-band> ;
    owl:versionInfo "2" ;
    skos:closeMatch ospd:raster-band-math ;
    skos:definition "Performs a calculation over imagery bands and returns the resulting raster using the specified band arithmetic."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Band Calculation"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    prov:qualifiedAttribution [ prov:agent <https://www.crim.ca> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ] .

ospd:raster-reprojection a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/raster-reprojection> ;
    dcterms:source [ ] ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Reprojects a raster coverage to another coordinate reference system, resampling pixel values as needed, preserving the coverage's content."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Raster reprojection"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> .

