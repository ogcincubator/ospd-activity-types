ospd:GA012 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA012> ;
    dcterms:source <https://en.wikipedia.org/wiki/Soil-adjusted_vegetation_index> ;
    owl:versionInfo "2" ;
    skos:broader ospd:GA008 ;
    skos:definition "NDVI with adjustments for soil colour, moisture and high density vegetation saturation effect"@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Soil-adjusted vegetation index (SAVI)"@en ;
    prov:qualifiedAttribution [ prov:agent <http://ospd/demo/martin-pontius> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ] .

ospd:GA013 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA013> ;
    dcterms:source <https://en.wikipedia.org/wiki/Normalized_difference_vegetation_index> ;
    owl:versionInfo "2" ;
    skos:broader ospd:GA008 ;
    skos:definition "Normalized difference vegetation index (NDVI)"@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "NDVI"@en ;
    prov:qualifiedAttribution [ prov:agent <http://ospd/demo/martin-pontius> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ] .

ospd:band-math a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/raster/band-math> ;
    skos:broader ospd:raster-band-math ;
    skos:definition "This application performs a mathematical operation on several multi-band images and outputs the result into a monoband image. The given expression is computed at each pixel position. Evaluation of the mathematical formula is done by the muParser library.The formula can be written using:* numerical values ( 2.3, -5, 3.1e4, ...)* variables containing pixel values (e.g. ``im2b3`` is the pixel value in 2nd image, 3rd band)* binary operators: * ``+`` addition, ``-`` subtraction, ``*`` multiplication, ``/`` division * ``^`` raise x to the power of y * ``"@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Outputs a monoband image which is the result of a mathematical operation on several multi-band images."@en .

ospd:band-math-multiband a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/raster/band-math-multiband> ;
    skos:broader ospd:raster-band-math-multiband ;
    skos:definition "This application performs a mathematical operation on several multi-band images and outputs the result into an image (multi- or mono-band, as opposed to the BandMath OTB-application). The mathematical formula is done by the muParserX library.The list of features and the syntax of muParserX is available at [1].As opposed to muParser (and thus the BandMath OTB-application [2]), muParserX supports vector expressions which allows outputting multi-band images.Hereafter is a brief reference of the muParserX syntaxFundamentals------------The formula can be written using:* numerical values ( 2.3, -5, 3.1e4, ...)* variables containing pixel values (please, note the indexing of inputs from 1 to N). Examples for the first input image: * ``im1`` a pixel from 1st input, made of n components (n bands) * ``im1b2`` the 2nd component of a pixel from 1st input (band index is 1-based) * ``im1b2N3x4`` a 3x4 pixels Neighbourhood of a pixel the 2nd component of a pixel from the 1st input * ``im1PhyX`` horizontal (X-axis) spacing of the 1st input. * ``im1PhyY`` vertical (Y-axis) spacing of the 1st input input. * ``im1b2Mean`` mean of the 2nd component of the 1st input (global statistics) * ``im1b2Mini`` minimum of the 2nd component of the 1st input (global statistics) * ``im1b2Maxi`` maximum of the 2nd component of the 1st input (global statistics) * ``im1b2Sum`` sum of the 2nd component of the 1st input (global statistics) * ``im1b2Var`` variance of the 2nd component of the 1st input (global statistics) * ``idxX`` and ``idxY`` are the indices of the current pixel (generic variables)* binary operators: * ``+`` addition, ``-`` subtraction, ``*`` multiplication, ``/`` division * ``^`` raise x to the power of y * ``"@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "This application performs mathematical operations on several multiband images."@en .

ospd:calculate-band a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/calculate-band> ;
    skos:broader ospd:raster-band-math ;
    skos:definition "Performs a calculation over JPEG bands and returns the resulting GeoTiff."@en ;
    skos:exactMatch <https://geolabs.github.io/bblocks-process-profiles/def/process-type/algae-bloom/calculate-band> ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Performs a calculation with bands."@en .

ospd:calculate-indices a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/kindgrove-steps/calculate-indices> ;
    skos:broader ospd:radiometric-index ;
    skos:definition "Computes NDVI, NDWI and SAVI from Sentinel-2 red, green and NIR bands."@en ;
    skos:exactMatch <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/calculate-indices> ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Compute NDVI, NDWI and SAVI"@en .

ospd:extent a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/raster/extent> ;
    skos:broader ospd:raster-extent ;
    skos:definition "Build a vector data containing the image envelope polygon. Useful for some projection, you can set the polygon with more points with the sr parameter. This filter supports user-specified output projection. If no projection is defined, the standard WGS84 projection will be used."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Extracts an image envelope."@en .

ospd:extract-roi a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/raster/extract-roi> ;
    skos:broader ospd:raster-crop ;
    skos:definition "This application extracts a Region Of Interest with user parameters. There are four mode of extraction. The standard mode allows the user to enter one point (upper left corner of the region to extract) and a size. The extent mode needs two points (upper left corner and lower right) and the radius mode need the center of the region and the radius: it will extract the rectangle containing the circle defined and limited by the image dimension. The fit mode needs a reference image or vector and the dimension of the extracted region will be the same as the extent of the reference. Different units are available such as pixel, image physical space or longitude and latitude."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Extract a ROI defined by the user."@en .

ospd:format-conversion a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/raster/format-conversion> ;
    skos:broader ospd:raster-format-conversion ;
    skos:definition "http://www.gdal.org/gdal_translate.html"@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Convert raster data from one format to another."@en .

ospd:norm-diff a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/water-bodies/norm-diff> ;
    skos:broader ospd:radiometric-index ;
    skos:definition "Computes the normalized difference index ((A-B)/(A+B)) of two co-registered rasters."@en ;
    skos:exactMatch <https://geolabs.github.io/bblocks-process-profiles/def/process-type/water-bodies/norm-diff> ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Normalized difference between two rasters"@en .

ospd:otsu a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/water-bodies/otsu> ;
    skos:broader ospd:otsu-thresholding ;
    skos:definition "Thresholds a single-band raster into a binary mask using Otsu's method."@en ;
    skos:exactMatch <https://geolabs.github.io/bblocks-process-profiles/def/process-type/water-bodies/otsu> ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Otsu binary threshold"@en .

ospd:plot-image a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/plot-image> ;
    skos:broader ospd:raster-rendering ;
    skos:definition "Applies the specified color mapping with scaled bins to a geospatial image."@en ;
    skos:exactMatch <https://geolabs.github.io/bblocks-process-profiles/def/process-type/algae-bloom/plot-image> ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Plots an image with colors."@en .

ospd:raster-radiometric-index a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/raster/radiometric-index> ;
    skos:broader ospd:radiometric-index ;
    skos:definition "This application computes radiometric indices using the relevant channels of the input image. The output is a multi band image into which each channel is one of the selected indices."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Compute radiometric indices."@en .

ospd:reproject-band a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/kindgrove-steps/reproject-band> ;
    skos:broader ospd:raster-reprojection ;
    skos:definition "Reprojects a raster onto a regular grid covering a bounding box."@en ;
    skos:exactMatch <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/reproject-band> ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Reproject a raster onto a regular grid"@en .

ospd:reproject-image a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/reproject-image> ;
    skos:broader ospd:raster-resampling ;
    skos:definition "Performs a reprojection over image bands and returns the resulting GeoTiff."@en ;
    skos:exactMatch <https://geolabs.github.io/bblocks-process-profiles/def/process-type/algae-bloom/reproject-image> ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "Performs image reprojection."@en .

ospd:reprojection a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/raster/reprojection> ;
    skos:broader ospd:raster-reprojection ;
    skos:definition "The gdalwarp utility is an image mosaicing, reprojection and warping utility. The program can reproject to any supported projection, and can also apply GCPs stored with the image if the image is \"raw\" with control information."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:prefLabel "GDAL Warp Tool"@en .

