@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ospd: <https://w3id.org/ogc/ospd/activity-type/> .
@prefix ospd-catalog: <https://w3id.org/ogc/ospd/> .

ospd-catalog:catalog a dcat:Catalog ;
    dcterms:description "Activity types specific to the OGC Open Science Persistent Demonstrator (OSPD): tool- and example-specific types, each specialising a generic activity type of the Activity Types Register (skos:broader)."@en ;
    dcterms:hasPart ospd-catalog:specific-activity-types ;
    dcterms:references ospd:catalog ;
    dcterms:title "OSPD Activity Types Register"@en .

