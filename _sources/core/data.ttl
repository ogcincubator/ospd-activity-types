@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ospd: <https://w3id.org/ogc/ospd/activity-type/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ospd:catalog a dcat:Catalog ;
    dcterms:description "Catalog of the OSPD activity types and their families."@en ;
    dcterms:hasPart ospd: ;
    dcterms:title "OSPD Activity Types"@en .

<https://w3id.org/ogc/ospd/activity-type/families/earth-observation> a skos:Collection ;
    skos:member ospd:GA014,
        ospd:GA015,
        ospd:GA016,
        ospd:band-retrieval,
        ospd:crop,
        ospd:detect-water-body,
        ospd:download-band,
        ospd:download-band-sentinel2-product-safe,
        ospd:download-band-sentinel2-stac-item,
        ospd:estimate-biomass,
        ospd:export-stac,
        ospd:mangrove,
        ospd:mangrove-workflow,
        ospd:mangrove-workflow-steps,
        ospd:parse-aoi,
        ospd:parse-aoi-steps,
        ospd:product-selection,
        ospd:select-products-sentinel2,
        ospd:select-scene,
        ospd:stac,
        ospd:water-bodies,
        ospd:workflow-copernicus,
        ospd:workflow-copernicus-process,
        ospd:workflow-earth-search,
        ospd:workflow-earth-search-process ;
    skos:prefLabel "Earth observation"@en .

<https://w3id.org/ogc/ospd/activity-type/families/information-extraction-and-retrieval> a skos:Collection ;
