    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/GA048"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

<https://w3id.org/ogc/ospd/activity-type/families/information-extraction-and-retrieval> a skos:ConceptScheme ;
    skos:definition "Source acquisition, text metadata enrichment (entity extraction, geotagging, classification, normalization) and retrieval-augmented generation."@en ;
    skos:hasTopConcept ospd:GA047,
        ospd:GA048,
        ospd:GA049,
        ospd:catalogue-search ;
    skos:prefLabel "Information extraction and retrieval"@en .

