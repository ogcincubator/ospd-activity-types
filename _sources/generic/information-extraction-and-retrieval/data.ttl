    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:GA045 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-23"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA045> ;
