ospd:GA040 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-23"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA040> ;
    dcterms:source <https://github.com/voyagersearch/voyager-prov-ts/blob/dev/docs/ospd-register-proposal.md> ;
    rdfs:seeAlso <http://ospd/demo/nlp-extract-entities> ;
    rdfs:subClassOf acttype:ActivityType ;
    owl:versionInfo "v1" ;
    skos:broader ospd:GA048 ;
    skos:definition "Named-entity recognition over document text. Emits structured entity mentions (persons, organizations, places, events, products). Semantically upstream of Geotag."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/information-extraction-and-retrieval> ;
    skos:prefLabel "NLP Entity Extraction"@en ;
    skos:related ospd:GA041 ;
    prov:qualifiedAttribution [ prov:agent [ foaf:name "Alex Bostic" ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ],
        [ prov:agent [ foaf:name "Voyager Search" ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ] ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/GA040"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:GA044 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-23"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA044> ;
