ospd:raster-regridding a skos:Concept,
        acttype:ActivityType ;
    dcterms:source <https://github.com/GeoLabs/bblocks-generic-profiles/blob/56fd9896e9e21cbd9d67c1fd3194917a4cc48934/scripts/activity-types.yaml#L682> ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Computes the values of a raster on another grid, of another coordinate reference system or of another resolution, by resampling the input values."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> ;
    skos:narrower ospd:raster-reprojection,
        ospd:raster-resampling ;
