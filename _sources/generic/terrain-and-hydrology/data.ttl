ospd:GA030 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA030> ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    owl:versionInfo "2" ;
    skos:closeMatch <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/terrain-derivative> ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/terrain-and-hydrology> ;
    skos:narrower ospd:analytical-hillshading,
        ospd:slope,
        ospd:terrain-ruggedness-index,
        ospd:topographic-position-index ;
    skos:prefLabel "Terrain analysis"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/terrain-and-hydrology> ;
    prov:qualifiedAttribution [ prov:agent <https://hartis.org> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ] ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/GA030"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

<https://w3id.org/ogc/ospd/activity-type/families/terrain-and-hydrology> a skos:ConceptScheme ;
    skos:definition "Terrain derivatives (slope, hillshading, ruggedness and position indices) and hydrological analysis (flow direction and accumulation, watersheds, stream networks, wetness index)."@en ;
    skos:hasTopConcept ospd:GA030,
        ospd:GA031,
        ospd:GA034,
        ospd:GA035 ;
    skos:prefLabel "Terrain and hydrology"@en .

