ospd:GA001 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA001> ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    owl:versionInfo "2" ;
    skos:closeMatch ospd:buffer ;
    skos:definition "Buffer is a Geoprocessing Activity that creates a zone of a specified distance around or inside an input geometry, such as a point, line, or polygon"@en ;
    skos:exactMatch <https://catalog.ospd.dev.kurrawong.ai/catalogs/demo:geoacs/collections/demo:ospd-geoacs/items/demo:GA001> ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Buffer"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    prov:qualifiedAttribution [ prov:agent <https://defs.opengis.net/org/ogc> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ],
        [ prov:agent [ foaf:name "Nicholas Car" ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ] ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/GA001"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:GA003 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA003> ;
    dcterms:source <https://geopandas.org/en/latest/docs/reference/api/geopandas.GeoSeries.envelope.html> ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    owl:versionInfo "2" ;
    skos:broader ospd:GA002 ;
    skos:closeMatch ospd:geometry-extent ;
    skos:definition "Envelope is a Geoprocessing Activity that returns the smallest rectangle with sides parallel to the coordinate axes that contains all the vertecies of an input geometry"@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Envelope"@en ;
    skos:related ospd:GA004 ;
    prov:qualifiedAttribution [ prov:agent [ foaf:name "Nicholas Car" ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ],
        [ prov:agent <https://defs.opengis.net/org/ogc> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ] ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/GA003"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:GA004 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA004> ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    owl:versionInfo "2" ;
    skos:broader ospd:GA002 ;
    skos:definition "Bounding Circle is a Geoprocessing Activity that returns the smallest circle that contains all the vertecies of an input geometry"@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Bounding Circle"@en ;
    skos:related ospd:GA003 ;
