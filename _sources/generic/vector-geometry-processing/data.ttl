    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/geometry-measure"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:geometry-property-test a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/geometry-property-test> ;
    dcterms:source <https://github.com/GeoLabs/bblocks-generic-profiles/blob/56fd9896e9e21cbd9d67c1fd3194917a4cc48934/scripts/activity-types.yaml#L722> ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Tests whether one geometry has a given property, such as being simple, empty or closed, and returns a boolean."@en ;
    skos:exactMatch <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/geometry-property-test> ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:narrower ospd:is-simple ;
    skos:note "Promoted by the OSPD 2026 activity-type triage (decision of 26 Nov 2026). Evidence in dcterms:source."@en ;
    skos:prefLabel "Geometry property test"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/geometry-property-test"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:set-operation a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/set-operation> ;
    dcterms:source <https://github.com/GeoLabs/bblocks-generic-profiles/blob/56fd9896e9e21cbd9d67c1fd3194917a4cc48934/scripts/activity-types.yaml#L628> ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Returns the geometry made of the points that belong to two input geometries according to a point-set operation (union, intersection, difference or symmetric difference)."@en ;
    skos:exactMatch <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/set-operation> ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:narrower ospd:difference,
        ospd:intersection,
        ospd:symdifference,
        ospd:union ;
    skos:note "Promoted by the OSPD 2026 activity-type triage (decision of 26 Nov 2026). Evidence in dcterms:source."@en ;
    skos:prefLabel "Set operation on geometries"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/set-operation"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:spatial-relation-test a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/spatial-relation-test> ;
    dcterms:source <https://github.com/GeoLabs/bblocks-generic-profiles/blob/56fd9896e9e21cbd9d67c1fd3194917a4cc48934/scripts/activity-types.yaml#L620> ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Tests whether a given spatial relation holds between two geometries, and returns a boolean."@en ;
    skos:exactMatch <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/spatial-relation-test> ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:narrower ospd:contains,
        ospd:crosses,
        ospd:disjoint,
        ospd:equals,
        ospd:intersects,
        ospd:touches,
        ospd:within ;
    skos:note "Promoted by the OSPD 2026 activity-type triage (decision of 26 Nov 2026). Evidence in dcterms:source."@en ;
    skos:prefLabel "Spatial relation test"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/spatial-relation-test"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:GA005 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA005> ;
    dcterms:source <https://geopandas.org/en/latest/docs/reference/api/geopandas.GeoSeries.concave_hull.html> ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    owl:versionInfo "2" ;
    skos:definition "Concave Hull is a Geoprocessing Activity that returns the smallest concave polygon containing all the vertecies in an input geometry, unless the number of vertecies in the input geometry is less than three. For two points, the concave hull collapses to a line; for one, a point."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Concave Hull"@en ;
    skos:related ospd:GA006 ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    prov:qualifiedAttribution [ prov:agent [ foaf:name "Nicholas Car" ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ],
        [ prov:agent <https://defs.opengis.net/org/ogc> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ] ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/GA005"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:GA006 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA006> ;
    dcterms:source <https://geopandas.org/en/latest/docs/reference/api/geopandas.GeoSeries.convex_hull.html> ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    owl:versionInfo "2" ;
    skos:closeMatch ospd:convex-hull ;
    skos:definition "Convex Hull is a Geoprocessing Activity that returns the smallest convex polygon containing all the vertecies in an input geometry, unless the number of vertecies in the input geometry is less than three. For two points, the concave hull collapses to a line; for one, a point."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Convex Hull"@en ;
    skos:related ospd:GA005 ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    prov:qualifiedAttribution [ prov:agent <https://defs.opengis.net/org/ogc> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ],
        [ prov:agent [ foaf:name "Nicholas Car" ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ] ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/GA006"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:geometry-extent a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/geometry-extent> ;
