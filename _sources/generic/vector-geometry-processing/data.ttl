    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/extent-computation"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

<https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> a skos:ConceptScheme ;
    skos:definition "Operations and tests on vector geometries: buffers, hulls, envelopes, set operations, spatial predicates and extents. The SQL/MM operations are a block of their own (ogc.register.ospd.generic.sqlmm)."@en ;
    skos:hasTopConcept ospd:GA001,
        ospd:GA002,
        ospd:GA005,
        ospd:GA006,
        ospd:GA019,
        ospd:GA020,
        ospd:extent-computation,
        ospd:geometry-construction,
        ospd:geometry-measure,
        ospd:geometry-property-test,
        ospd:set-operation,
        ospd:spatial-relation-test ;
    skos:prefLabel "Vector geometry processing"@en .

