@prefix acttype: <https://w3id.org/ogc/rim/activity-type/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ospd: <https://w3id.org/ogc/ospd/activity-type/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ospd:area a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/area> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf ospd:geometry-measure ;
    skos:broader ospd:geometry-measure ;
    skos:definition "The area of this Surface, as measured in the spatial reference system of this Surface."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    skos:narrower ospd:sqlmm-area ;
    skos:prefLabel "Area"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/area"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:buffer a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/buffer> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf ospd:geometry-construction ;
    skos:broader ospd:geometry-construction ;
    skos:definition "Returns a geometric object representing all points whose distance from this geometric object is less than or equal to a given distance."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    skos:narrower ospd:sqlmm-buffer ;
    skos:prefLabel "Buffer"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/buffer"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:centroid a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/centroid> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf ospd:geometry-construction ;
    skos:broader ospd:geometry-construction ;
    skos:definition "The mathematical centroid for this Surface as a Point. The result is not guaranteed to be on this Surface."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    skos:narrower ospd:sqlmm-centroid ;
    skos:prefLabel "Centroid"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/centroid"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:contains a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/contains> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf ospd:spatial-relation-test ;
    skos:broader ospd:spatial-relation-test ;
    skos:definition "Returns TRUE if this geometric object spatially contains anotherGeometry (no point of anotherGeometry lies outside this geometric object, and at least one point of the interior of anotherGeometry lies in the interior of this geometric object)."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    skos:narrower ospd:sqlmm-contains ;
    skos:prefLabel "Contains"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/contains"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:convex-hull a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/convex-hull> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf ospd:geometry-construction ;
    skos:broader ospd:geometry-construction ;
    skos:definition "Returns a geometry that represents the convex hull of this Geometry."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    skos:narrower ospd:sqlmm-convex-hull ;
    skos:prefLabel "Convex hull"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/convex-hull"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:crosses a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/crosses> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf ospd:spatial-relation-test ;
    skos:broader ospd:spatial-relation-test ;
    skos:definition "Returns TRUE if this geometric object 'spatially crosses' anotherGeometry: the intersection results in a geometry of dimension one less than the maximum dimension of the two source geometries, and the intersection set is interior to both."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    skos:narrower ospd:sqlmm-crosses ;
    skos:prefLabel "Crosses"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/crosses"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:difference a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/difference> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf ospd:set-operation ;
    skos:broader ospd:set-operation ;
    skos:definition "Returns a geometric object representing the point set difference of this geometric object with anotherGeometry."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    skos:narrower ospd:sqlmm-difference ;
    skos:prefLabel "Difference"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/difference"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:disjoint a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/disjoint> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf ospd:spatial-relation-test ;
    skos:broader ospd:spatial-relation-test ;
    skos:definition "Returns TRUE if this geometric object is spatially disjoint from anotherGeometry (they share no point). Equivalent to the negation of Intersects."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    skos:narrower ospd:sqlmm-disjoint ;
    skos:prefLabel "Disjoint"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/disjoint"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:equals a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/equals> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf ospd:spatial-relation-test ;
    skos:broader ospd:spatial-relation-test ;
    skos:definition "Returns TRUE if this geometric object is spatially equal to anotherGeometry (same point set), independent of vertex order or representation."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    skos:narrower ospd:sqlmm-equals ;
    skos:prefLabel "Equals"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/equals"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:intersection a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/intersection> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf ospd:set-operation ;
    skos:broader ospd:set-operation ;
    skos:definition "Returns a geometric object representing the point set intersection of this geometric object with anotherGeometry."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    skos:narrower ospd:sqlmm-intersection ;
    skos:prefLabel "Intersection"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/intersection"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:intersects a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/intersects> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf ospd:spatial-relation-test ;
    skos:broader ospd:spatial-relation-test ;
    skos:definition "Returns TRUE if this geometric object spatially intersects anotherGeometry (i.e. they share at least one point). Equivalent to the negation of Disjoint."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    skos:narrower ospd:sqlmm-intersects ;
    skos:prefLabel "Intersects"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/intersects"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:is-simple a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/is-simple> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf ospd:geometry-property-test ;
    skos:broader ospd:geometry-property-test ;
    skos:definition "Returns 1 (TRUE) if this Geometry has no anomalous geometric points, such as self intersection or self tangency."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    skos:narrower ospd:sqlmm-is-simple ;
    skos:prefLabel "Is simple"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/is-simple"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:symdifference a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/symdifference> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf ospd:set-operation ;
    skos:broader ospd:set-operation ;
    skos:definition "Returns a geometric object representing the point set symmetric difference of this geometric object with anotherGeometry."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    skos:narrower ospd:sqlmm-symdifference ;
    skos:prefLabel "Symmetric difference"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/symdifference"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:touches a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/touches> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf ospd:spatial-relation-test ;
    skos:broader ospd:spatial-relation-test ;
    skos:definition "Returns TRUE if the only points in common between this geometric object and anotherGeometry lie in the union of their boundaries: at least one boundary point in common, but no interior points in common."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    skos:narrower ospd:sqlmm-touches ;
    skos:prefLabel "Touches"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/touches"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:union a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/union> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf ospd:set-operation ;
    skos:broader ospd:set-operation ;
    skos:definition "Returns a geometric object representing the point set union of this geometric object with anotherGeometry."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    skos:narrower ospd:sqlmm-union ;
    skos:prefLabel "Union"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/union"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:within a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/within> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf ospd:spatial-relation-test ;
    skos:broader ospd:spatial-relation-test ;
    skos:definition "Returns TRUE if this geometric object is spatially within anotherGeometry. The converse of Contains."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    skos:narrower ospd:sqlmm-within ;
    skos:prefLabel "Within"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/sqlmm> ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/within"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

<https://w3id.org/ogc/ospd/activity-type/families/sqlmm> a skos:ConceptScheme ;
    dcterms:source <https://www.ogc.org/standards/sfa/> ;
    skos:definition "The spatial operations and predicates on geometries defined by ISO/IEC 13249-3 (SQL/MM Spatial) and OGC Simple Features Access: area, buffer, centroid, convex hull, the set operations and the spatial relation tests. Each specialises a grouping type of vector geometry processing."@en ;
    skos:hasTopConcept ospd:area,
        ospd:buffer,
        ospd:centroid,
        ospd:contains,
        ospd:convex-hull,
        ospd:crosses,
        ospd:difference,
        ospd:disjoint,
        ospd:equals,
        ospd:intersection,
        ospd:intersects,
        ospd:is-simple,
        ospd:symdifference,
        ospd:touches,
        ospd:union,
        ospd:within ;
    skos:note "Split from vector geometry processing (refactor of 26 Nov 2026)."@en ;
    skos:prefLabel "SQL/MM spatial operations"@en .

