@prefix acttype: <https://w3id.org/ogc/rim/activity-type/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ospd: <https://w3id.org/ogc/ospd/activity-type/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ospd:sqlmm-area a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/area> ;
    skos:broader ospd:area ;
    skos:definition "Computes the area of a geometry"@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Compute geometry area."@en .

ospd:sqlmm-buffer a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/buffer> ;
    skos:broader ospd:buffer ;
    skos:definition "This service shall return a feature collection representing the buffer of geometry InputPolygon at distance BufferDistance. The buffer of a geometry at distance d is the Polygon or MultiPolygon which contains all points within a distance d of the geometry."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Create a buffer around a polygon."@en .

ospd:sqlmm-centroid a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/centroid> ;
    skos:broader ospd:centroid ;
    skos:definition "This service shall return the point that is the geometric centre of gravity of the geometry InputPolygon."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Computes the centroid of a polygon."@en .

ospd:sqlmm-contains a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/contains> ;
    skos:broader ospd:contains ;
    skos:definition "This service shall return a true value if and only if the geometry g2 lies in the closure (boundary union interior) of geometry g1 - the inverse of Within(g1: Geometry, g2: Geometry)."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Contains"@en .

ospd:sqlmm-convex-hull a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/convex-hull> ;
    skos:broader ospd:convex-hull ;
    skos:definition "This service shall return a feature collection that represents the convex hull of geometry InputPolygon. The convex hull is the smallest convex polygon that contains all points of the geometry. The convex Hull for a geometry of encoding data type Point is the point itself"@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Compute convex hull."@en .

ospd:sqlmm-crosses a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/crosses> ;
    skos:broader ospd:crosses ;
    skos:definition "This service shall return a true value if and only if the geometries g1 and g2 share some but neither is containe in the other, and the dimension of the intersection is less than that of both of the geometries."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Crosses test"@en .

ospd:sqlmm-difference a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/difference> ;
    skos:broader ospd:difference ;
    skos:definition "This function shall return a bag of geometry values representing the closure of the set difference between the two geometries InputEntity1 and InputEntity2. The difference is the set of all points which lie on InputEntity1 but not on InputEntity2."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Compute difference."@en .

ospd:sqlmm-disjoint a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/disjoint> ;
    skos:broader ospd:disjoint ;
    skos:definition "This servuce shall return a true value if and only if the geometries g1 and g2 have no point in common."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Disjoint"@en .

ospd:sqlmm-equals a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/equals> ;
    skos:broader ospd:equals ;
    skos:definition "This service shall return a true value if and only if the geometries g1 and g2 are equal"@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Equals"@en .

ospd:sqlmm-intersection a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/intersection> ;
    skos:broader ospd:intersection ;
    skos:definition "This function SHALL return a bag of geometry values representing the Point set intersection of geometry InputEntity1 and geometry InputEntity2."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Compute intersection."@en .

ospd:sqlmm-intersects a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/intersects> ;
    skos:broader ospd:intersects ;
    skos:definition "This service shall return a true value if and only if the geometries g1 and g2 have at least one boundary point in common, but no interior points."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Intersects test"@en .

ospd:sqlmm-is-simple a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/is-simple> ;
    skos:broader ospd:is-simple ;
    skos:definition "This service shall return a true value if and only if geometry g has no anomalous geometric points, such as self intersection or self tangency. Simple curves intersect themselves only at their endpoints (only if they are also closed, see next function)."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "IsSimple test"@en .

ospd:sqlmm-symdifference a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/symdifference> ;
    skos:broader ospd:symdifference ;
    skos:definition "This service shall return a feature collection representing the closure of the symmetric difference of two Geometries. The symmetric difference is the set of points which lie on either InputEntity1 or InputEntity2 but not in both."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Compute symmetric difference."@en .

ospd:sqlmm-touches a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/touches> ;
    skos:broader ospd:touches ;
    skos:definition "Generates a new geometry which is the region of intersection of the two geometries operated on."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Compute intersection."@en .

ospd:sqlmm-union a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/union> ;
    skos:broader ospd:union ;
    skos:definition "This service shall return a bag of geometry values representing a Point set union of geometry InputEntity1 with geometry InputEntity2."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Compute union."@en .

ospd:sqlmm-within a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/within> ;
    skos:broader ospd:within ;
    skos:definition "This service shall return a true value if and only if the geometry InputEntity1 is spatially within geometry InputEntity2; that is if every point on InputEntity1 is also on InputEntity2."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Within test"@en .

ospd:vector-geometry-extent a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/vector/geometry-extent> ;
    skos:broader ospd:geometry-extent ;
    skos:definition "Get Shapes Extents"@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Get Shapes Extents"@en .

ospd:GA001 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA001> ;
    owl:versionInfo "2" ;
    skos:closeMatch ospd:buffer ;
    skos:definition "Buffer is a Geoprocessing Activity that creates a zone of a specified distance around or inside an input geometry, such as a point, line, or polygon"@en ;
    skos:exactMatch <https://catalog.ospd.dev.kurrawong.ai/catalogs/demo:geoacs/collections/demo:ospd-geoacs/items/demo:GA001> ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Buffer"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    prov:qualifiedAttribution [ prov:agent [ foaf:name "Nicholas Car" ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ],
        [ prov:agent <https://defs.opengis.net/org/ogc> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ] .

ospd:GA003 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA003> ;
    dcterms:source <https://geopandas.org/en/latest/docs/reference/api/geopandas.GeoSeries.envelope.html> ;
    owl:versionInfo "2" ;
    skos:broader ospd:GA002 ;
    skos:closeMatch ospd:geometry-extent ;
    skos:definition "Envelope is a Geoprocessing Activity that returns the smallest rectangle with sides parallel to the coordinate axes that contains all the vertecies of an input geometry"@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Envelope"@en ;
    skos:related ospd:GA004 ;
    prov:qualifiedAttribution [ prov:agent <https://defs.opengis.net/org/ogc> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ],
        [ prov:agent [ foaf:name "Nicholas Car" ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ] .

ospd:GA004 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA004> ;
    owl:versionInfo "2" ;
    skos:broader ospd:GA002 ;
    skos:definition "Bounding Circle is a Geoprocessing Activity that returns the smallest circle that contains all the vertecies of an input geometry"@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Bounding Circle"@en ;
    skos:related ospd:GA003 .

ospd:GA019 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA019> ;
    dcterms:source <https://shapely.readthedocs.io/en/stable/reference/shapely.difference.html> ;
    owl:versionInfo "2" ;
    skos:closeMatch ospd:difference ;
    skos:definition "Calculate the difference between two geometries."@en ;
    skos:exactMatch <https://catalog.ospd.dev.kurrawong.ai/catalogs/demo:geoacs/collections/demo:ospd-geoacs/items/demo:GA019> ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Difference"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    prov:qualifiedAttribution [ prov:agent <http://ospd/demo/martin-pontius> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ] .

ospd:GA020 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA020> ;
    owl:versionInfo "2" ;
    skos:definition "Filter a list of geometries based on some criteria (e.g. attribute, area)."@en ;
    skos:exactMatch <https://catalog.ospd.dev.kurrawong.ai/catalogs/demo:geoacs/collections/demo:ospd-geoacs/items/demo:GA020> ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Filter geometries"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    prov:qualifiedAttribution [ prov:agent <http://ospd/demo/martin-pontius> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ] .

ospd:GA005 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA005> ;
    dcterms:source <https://geopandas.org/en/latest/docs/reference/api/geopandas.GeoSeries.concave_hull.html> ;
    owl:versionInfo "2" ;
    skos:definition "Concave Hull is a Geoprocessing Activity that returns the smallest concave polygon containing all the vertecies in an input geometry, unless the number of vertecies in the input geometry is less than three. For two points, the concave hull collapses to a line; for one, a point."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Concave Hull"@en ;
    skos:related ospd:GA006 ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    prov:qualifiedAttribution [ prov:agent <https://defs.opengis.net/org/ogc> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ],
        [ prov:agent [ foaf:name "Nicholas Car" ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ] .

ospd:GA006 a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:replaces <http://ospd/demo/GA006> ;
    dcterms:source <https://geopandas.org/en/latest/docs/reference/api/geopandas.GeoSeries.convex_hull.html> ;
    owl:versionInfo "2" ;
    skos:closeMatch ospd:convex-hull ;
    skos:definition "Convex Hull is a Geoprocessing Activity that returns the smallest convex polygon containing all the vertecies in an input geometry, unless the number of vertecies in the input geometry is less than three. For two points, the concave hull collapses to a line; for one, a point."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Convex Hull"@en ;
    skos:related ospd:GA005 ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    prov:qualifiedAttribution [ prov:agent <https://defs.opengis.net/org/ogc> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ],
        [ prov:agent [ foaf:name "Nicholas Car" ] ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/pointOfContact> ] .

ospd:area a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/area> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "The area of this Surface, as measured in the spatial reference system of this Surface."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Area"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> .

ospd:centroid a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/centroid> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "The mathematical centroid for this Surface as a Point. The result is not guaranteed to be on this Surface."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Centroid"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> .

ospd:contains a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/contains> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Returns TRUE if this geometric object spatially contains anotherGeometry (no point of anotherGeometry lies outside this geometric object, and at least one point of the interior of anotherGeometry lies in the interior of this geometric object)."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Contains"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> .

ospd:crosses a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/crosses> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Returns TRUE if this geometric object 'spatially crosses' anotherGeometry: the intersection results in a geometry of dimension one less than the maximum dimension of the two source geometries, and the intersection set is interior to both."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Crosses"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> .

ospd:disjoint a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/disjoint> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Returns TRUE if this geometric object is spatially disjoint from anotherGeometry (they share no point). Equivalent to the negation of Intersects."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Disjoint"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> .

ospd:equals a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/equals> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Returns TRUE if this geometric object is spatially equal to anotherGeometry (same point set), independent of vertex order or representation."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Equals"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> .

ospd:intersection a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/intersection> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Returns a geometric object representing the point set intersection of this geometric object with anotherGeometry."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Intersection"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> .

ospd:intersects a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/intersects> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Returns TRUE if this geometric object spatially intersects anotherGeometry (i.e. they share at least one point). Equivalent to the negation of Disjoint."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Intersects"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> .

ospd:is-simple a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/is-simple> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Returns 1 (TRUE) if this Geometry has no anomalous geometric points, such as self intersection or self tangency."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Is simple"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> .

ospd:symdifference a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/symdifference> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Returns a geometric object representing the point set symmetric difference of this geometric object with anotherGeometry."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Symmetric difference"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> .

ospd:touches a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/touches> ;
    dcterms:source [ ],
        [ ] ;
    rdfs:subClassOf <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivityType> ;
    skos:definition "Returns TRUE if the only points in common between this geometric object and anotherGeometry lie in the union of their boundaries: at least one boundary point in common, but no interior points in common."@en ;
    skos:inScheme <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> ;
    skos:prefLabel "Touches"@en ;
    skos:topConceptOf <https://w3id.org/ogc/ospd/activity-type/families/vector-geometry-processing> .

