ospd:ZonalStatistics a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://example.org/ospd/process-types/ZonalStatistics> ;
    rdfs:seeAlso <https://example.org/ospd/process-types/zonal-statistics> ;
    skos:broader ospd:GA027 ;
    skos:closeMatch ospd:GA027 ;
