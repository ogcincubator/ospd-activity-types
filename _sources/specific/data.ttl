    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/calculate-band> ;
    skos:broader ospd:raster-band-math ;
    skos:definition "Performs a calculation over JPEG bands and returns the resulting GeoTiff."@en ;
    skos:exactMatch <https://geolabs.github.io/bblocks-process-profiles/def/process-type/algae-bloom/calculate-band> ;
    skos:inScheme ospd-catalog:specific-activity-types ;
    skos:prefLabel "Performs a calculation with bands."@en ;
    skos:topConceptOf ospd-catalog:specific-activity-types ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/calculate-band"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

