    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/calculate-indices"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:climate-downscaling-inference a skos:Concept,
        acttype:ActivityType ;
    dcterms:modified "2026-10-15"^^xsd:date ;
    dcterms:replaces <https://crim-ca.github.io/bblocks-process-profiles/def/activity-type/climate-downscaling-inference> ;
