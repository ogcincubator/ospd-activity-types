ospd:terrain-slope a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/terrain/slope> ;
    skos:broader ospd:slope ;
    skos:definition "Calculates the local morphometric terrain parameters slope, aspect and if supported by the chosen method also the curvature. Besides tangential curvature also its horizontal and vertical components (i.e. plan and profile curvature) can be calculated."@en ;
    skos:inScheme ospd-catalog:specific-activity-types ;
    skos:prefLabel "Slope, Aspect, Curvature"@en ;
    skos:topConceptOf ospd-catalog:specific-activity-types ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/terrain-slope"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
