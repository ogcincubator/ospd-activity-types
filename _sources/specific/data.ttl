ospd:extent a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/raster/extent> ;
    skos:broader ospd:raster-extent ;
    skos:definition "Build a vector data containing the image envelope polygon. Useful for some projection, you can set the polygon with more points with the sr parameter. This filter supports user-specified output projection. If no projection is defined, the standard WGS84 projection will be used."@en ;
    skos:inScheme ospd-catalog:specific-activity-types ;
    skos:prefLabel "Extracts an image envelope."@en ;
    skos:topConceptOf ospd-catalog:specific-activity-types ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/extent"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:extract-roi a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/raster/extract-roi> ;
    skos:broader ospd:raster-crop ;
    skos:definition "This application extracts a Region Of Interest with user parameters. There are four mode of extraction. The standard mode allows the user to enter one point (upper left corner of the region to extract) and a size. The extent mode needs two points (upper left corner and lower right) and the radius mode need the center of the region and the radius: it will extract the rectangle containing the circle defined and limited by the image dimension. The fit mode needs a reference image or vector and the dimension of the extracted region will be the same as the extent of the reference. Different units are available such as pixel, image physical space or longitude and latitude."@en ;
    skos:inScheme ospd-catalog:specific-activity-types ;
    skos:prefLabel "Extract a ROI defined by the user."@en ;
    skos:topConceptOf ospd-catalog:specific-activity-types ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/extract-roi"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:format-conversion a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/raster/format-conversion> ;
    skos:broader ospd:raster-format-conversion ;
    skos:definition "http://www.gdal.org/gdal_translate.html"@en ;
    skos:inScheme ospd-catalog:specific-activity-types ;
    skos:prefLabel "Convert raster data from one format to another."@en ;
    skos:topConceptOf ospd-catalog:specific-activity-types ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/format-conversion"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:hillshading a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/terrain/hillshading> ;
    skos:broader ospd:analytical-hillshading ;
    skos:definition "This tool performs an analytical hillshade computation for an elevation grid. The 'Standard' method simply calculates the angle at which light coming from the position of the light source would hit the surface. This method can produce angles greater than 90 degree. With the second method all values are kept within the range of 0-90 degree. It can be enhanced with shadowing effects, where shadowed cells will be marked with a value of exactly 90 degree. 'Shadows Only' creates a mask for the shadowed areas and sets all other cells to no-data. 'Combined Shading' takes the values of the standard method and multiplies these with the normalized slope. 'Ambient Occlusion' is based on the concepts of Tarini et al. (2006), but only the northern half-space is considered here."@en ;
    skos:inScheme ospd-catalog:specific-activity-types ;
    skos:prefLabel "Analytical Hillshading"@en ;
    skos:topConceptOf ospd-catalog:specific-activity-types ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/hillshading"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:mangrove a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/kindgrove/mangrove> ;
    skos:definition "Detects mangroves from Sentinel-2 L2A vegetation indices within a bounding box and estimates above-ground biomass and carbon stock (ipython2cwl binary of the KindGrove notebook)."@en ;
    skos:exactMatch <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove/mangrove> ;
    skos:inScheme ospd-catalog:specific-activity-types ;
    skos:prefLabel "Mangrove biomass and carbon estimation"@en ;
    skos:topConceptOf ospd-catalog:specific-activity-types ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/mangrove"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:mangrove-workflow-steps a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/kindgrove-steps/mangrove-workflow-steps> ;
    skos:closeMatch ospd:mangrove-workflow ;
    skos:definition "Mangrove above-ground biomass and carbon stock estimation from Sentinel-2 L2A, split into one CommandLineTool per processing step, aligned on the steps of the OSPD W1 Algae Bloom workflow: parse_aoi -> select_scene -> download_band (x3) -> reproject_band (x3) -> calculate_indices -> estimate_biomass -> export_stac."@en ;
    skos:exactMatch <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/mangrove-workflow-steps> ;
    skos:inScheme ospd-catalog:specific-activity-types ;
    skos:prefLabel "Mangrove Biomass Workflow (step notebooks)"@en ;
    skos:topConceptOf ospd-catalog:specific-activity-types ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/mangrove-workflow-steps"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:norm-diff a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/water-bodies/norm-diff> ;
    skos:broader ospd:radiometric-index ;
    skos:definition "Computes the normalized difference index ((A-B)/(A+B)) of two co-registered rasters."@en ;
    skos:exactMatch <https://geolabs.github.io/bblocks-process-profiles/def/process-type/water-bodies/norm-diff> ;
    skos:inScheme ospd-catalog:specific-activity-types ;
    skos:prefLabel "Normalized difference between two rasters"@en ;
    skos:topConceptOf ospd-catalog:specific-activity-types ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/norm-diff"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:otsu a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/water-bodies/otsu> ;
    skos:broader ospd:otsu-thresholding ;
    skos:definition "Thresholds a single-band raster into a binary mask using Otsu's method."@en ;
