    skos:broader ospd:touches ;
    skos:definition "Generates a new geometry which is the region of intersection of the two geometries operated on."@en ;
    skos:inScheme ospd-catalog:specific-activity-types ;
    skos:prefLabel "Compute intersection."@en ;
    skos:topConceptOf ospd-catalog:specific-activity-types ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/sqlmm-touches"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:sqlmm-union a skos:Concept,
