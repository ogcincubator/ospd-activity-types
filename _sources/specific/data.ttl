    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/union> ;
    skos:broader ospd:union ;
    skos:definition "This service shall return a bag of geometry values representing a Point set union of geometry InputEntity1 with geometry InputEntity2."@en ;
    skos:inScheme ospd-catalog:specific-activity-types ;
