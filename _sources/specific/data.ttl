ospd:workflow-copernicus-process a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/workflow-copernicus-process> ;
    skos:definition "Performs band calculation on Sentinel-2 product bands to evaluate algae bloom for water quality assessment."@en ;
    skos:exactMatch <https://geolabs.github.io/bblocks-process-profiles/def/process-type/algae-bloom/workflow-copernicus-process> ;
    skos:inScheme ospd-catalog:specific-activity-types ;
    skos:prefLabel "Processing on Sentinel-2 bands to evaluate algae bloom."@en ;
