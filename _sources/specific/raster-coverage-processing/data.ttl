@prefix acttype: <https://w3id.org/ogc/rim/activity-type/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ospd: <https://w3id.org/ogc/ospd/activity-type/> .
@prefix ospd-specific: <https://w3id.org/ogc/ospd/specific-activity-types/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ospd:cvi-elevation-analysis a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://example.org/ospd/process-types/elevation-analysis> ;
    dcterms:source <https://github.com/hartis-org/cvi-workflow/blob/b6f8e98a07be3320a2a936a23cb427009abd12d0/ospd2026/provenance/cvi_full_workflow_design_runtime_entities.json#L81> ;
    rdfs:subClassOf ospd:GA028 ;
    skos:broader ospd:GA028 ;
    skos:definition "Samples Copernicus DEM elevation along the transects and scores it."@en ;
    skos:inScheme ospd-specific:raster-coverage-processing ;
    skos:note "Contributed to OSPD 2026 by hartis-org (cvi-workflow); defined here (decision of 26 Nov 2026). Evidence in dcterms:source."@en ;
    skos:prefLabel "Elevation analysis"@en ;
    skos:topConceptOf ospd-specific:raster-coverage-processing ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/cvi-elevation-analysis"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:cvi-land-cover-analysis a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://example.org/ospd/process-types/land-cover-analysis> ;
    dcterms:source <https://github.com/hartis-org/cvi-workflow/blob/b6f8e98a07be3320a2a936a23cb427009abd12d0/ospd2026/provenance/cvi_full_workflow_design_runtime_entities.json#L60> ;
    rdfs:subClassOf ospd:GA028 ;
    skos:broader ospd:GA028 ;
    skos:definition "Samples ESA WorldCover land cover along the transects and scores it."@en ;
    skos:inScheme ospd-specific:raster-coverage-processing ;
    skos:note "Contributed to OSPD 2026 by hartis-org (cvi-workflow); defined here (decision of 26 Nov 2026). Evidence in dcterms:source."@en ;
    skos:prefLabel "Land-cover analysis"@en ;
    skos:topConceptOf ospd-specific:raster-coverage-processing ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/cvi-land-cover-analysis"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd-specific:raster-coverage-processing a skos:ConceptScheme ;
    dcterms:isPartOf <https://w3id.org/ogc/ospd/catalog> ;
    skos:definition "Activity types specific to an OSPD tool, product or workflow that specialise the generic types of the family raster and coverage processing, and that OSPD participants contributed to this register."@en ;
    skos:hasTopConcept ospd:cvi-elevation-analysis,
        ospd:cvi-land-cover-analysis ;
    skos:prefLabel "OSPD specific activity types: raster and coverage processing"@en .

