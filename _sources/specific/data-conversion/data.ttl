@prefix acttype: <https://w3id.org/ogc/rim/activity-type/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ospd: <https://w3id.org/ogc/ospd/activity-type/> .
@prefix ospd-specific: <https://w3id.org/ogc/ospd/specific-activity-types/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ospd:cool-spots-output-export a skos:Concept,
        acttype:ActivityType ;
    dcterms:replaces <https://example.org/cool-spots#exportOutputs> ;
    dcterms:source <https://github.com/ogcincubator/bblocks-openscience/blob/02f6895/_sources/prov-examples/52n-provenance/cool-spots/example.json#L382> ;
    rdfs:subClassOf acttype:ActivityType ;
    skos:definition "Writes the outputs of the cool-spots analysis (city boundary, cool spots, buffers and unserved areas) to files, as the output package of the run."@en ;
    skos:editorialNote "Definition drafted on 26 Nov 2026 from the label and data of the example step; to be confirmed by the contributor."@en ;
    skos:inScheme ospd-specific:data-conversion ;
    skos:note "Contributed to OSPD 2026 by 52North (bblocks-openscience cool-spots example); defined here (decision of 26 Nov 2026). No tool-neutral generic parent yet: open question. Evidence in dcterms:source."@en ;
    skos:prefLabel "Output export"@en ;
    skos:topConceptOf ospd-specific:data-conversion ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/cool-spots-output-export"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd:lightning2earthcare-feature-construction a skos:Concept,
        acttype:ActivityType ;
    dcterms:source <https://github.com/sunnydean/lightning2earthcare/blob/be63866b12733db5ef7349205d36d8af8ea937f1/cwl/ospd2026/registry/geoprocessing-activities.jsonld#L43> ;
    rdfs:subClassOf ospd:spatial-model-conversion ;
    skos:broader ospd:spatial-model-conversion ;
    skos:definition "Builds point features with measurements, times and identifiers from NetCDF observations and storm records, and writes them as GeoParquet."@en ;
    skos:inScheme ospd-specific:data-conversion ;
    skos:notation "conversion" ;
    skos:note "Contributed to OSPD 2026 by lightning2earthcare (sunnydean); defined here (decision of 26 Nov 2026). Evidence in dcterms:source."@en ;
    skos:prefLabel "Geospatial feature construction"@en ;
    skos:topConceptOf ospd-specific:data-conversion ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/ogc/ospd/activity-type/lightning2earthcare-feature-construction"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:valid .

ospd-specific:data-conversion a skos:ConceptScheme ;
    dcterms:isPartOf <https://w3id.org/ogc/ospd/catalog> ;
    skos:definition "Activity types specific to an OSPD tool, product or workflow that specialise the generic types of the family data conversion, and that OSPD participants contributed to this register."@en ;
    skos:hasTopConcept ospd:cool-spots-output-export,
        ospd:lightning2earthcare-feature-construction ;
    skos:prefLabel "OSPD specific activity types: data conversion"@en .

