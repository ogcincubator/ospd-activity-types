digraph G {
  rankdir=BT; nodesep=0.35; ranksep=0.55;
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, margin="0.18,0.10"];
  edge [fontname="DejaVu Sans", fontsize=9];
  rim [fillcolor="#e8eef7", label=<<B>RIM: Registered Item Model</B><BR/>ISO 19135:2026 register model<BR/><FONT POINT-SIZE="9">registered-item-model · ogc.rim.*</FONT>>];
  gen [fillcolor="#e6f2e6", label=<<B>Activity Types Register (generic)</B><BR/>activity-type profiles + 88 generic types in families<BR/><FONT POINT-SIZE="9">activity-type-register · ogc.register.*</FONT>>];
