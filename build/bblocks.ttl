        <bblocks://ogc.register.ospd.generic.spatial-indexing>,
        <bblocks://ogc.register.ospd.generic.sqlmm>,
        <bblocks://ogc.register.ospd.generic.terrain-and-hydrology>,
        <bblocks://ogc.register.ospd.generic.vector-geometry-processing>,
        <bblocks://ogc.register.ospd.generic.workflow-and-scoring>,
        <bblocks://ogc.register.ospd.profiles.activity-types>,
        <bblocks://ogc.register.ospd.profiles.geoprocessing-activity-types>,
        <bblocks://ogc.register.ospd.profiles.schemas.activity-types-schema>,
