            rdfs:isDefinedBy <https://ogcincubator.github.io/ospd-activity-types/bblock/ogc.register.ospd.profiles.schemas.st-ml-activity-types-schema> ],
        "See the ogc.register.ospd.profiles.st-ml-activity-types model for the description of the SpatioTemporal ML Activity Types Profile. This building block is a Schema representation of that block for json schema implementation purposes."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
