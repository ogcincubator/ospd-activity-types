<https://ogcincubator.github.io/ospd-activity-types/> a skos:ConceptScheme,
        dcat:Catalog,
        bblocks:BBlocksRegister ;
    rdfs:label "Building Blocks - OSPD Activity Types Register" ;
    dct:abstract """Activity types specific to the OGC Open Science Persistent Demonstrator (OSPD), under stable
`https://w3id.org/ogc/ospd/activity-type/` URIs, each specialising a generic activity type.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:description """The OSPD-specific activity types (tool- and example-specific), as a federated register of the
[Activity Types Register](https://ogcincubator.github.io/activity-type-register/): a root block (catalog)
and a `specific` block carrying the Turtle definitions of the types, whose data is uploaded to the OSPD
Prez instance when the register is built. Each type points to its generic parent with `skos:broader`.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:modified "2026-11-25T11:11:26.010864"^^xsd:dateTime ;
    void:sparqlEndpoint <https://defs-hosted.opengis.net/fuseki-ospd/query> ;
    owl:imports <https://ogcincubator.github.io/activity-type-register/build/register.json>,
        <https://ogcincubator.github.io/registered-item-model/build/register.json>,
        <https://opengeospatial.github.io/bblocks/register.json> ;
    skos:hasTopConcept <bblocks://ogc.ospd.activity-type.core>,
        <bblocks://ogc.ospd.activity-type.specific> ;
    skos:prefLabel "Building Blocks - OSPD Activity Types Register" ;
    prof:hasResource [ rdfs:label "This Building Blocks Register in JSON format" ;
            dct:type "application/json" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://ogcincubator.github.io/ospd-activity-types/build/register.json> ],
        [ rdfs:label "This Building Blocks Register in JSON-LD format" ;
            dct:type "application/ld+json" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://ogcincubator.github.io/ospd-activity-types/build/bblocks.jsonld> ],
        [ rdfs:label "This Building Blocks Register in RDF Turtle format" ;
            dct:type "text/turtle" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://ogcincubator.github.io/ospd-activity-types/build/bblocks.ttl> ] ;
    foaf:homepage <https://ogcincubator.github.io/ospd-activity-types/> ;
    bblocks:hasValidationReport <https://ogcincubator.github.io/ospd-activity-types/build/tests/report.html> .

