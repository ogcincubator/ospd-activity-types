        <bblocks://ogc.ospd.activity-type.spatial-indexing>,
        <bblocks://ogc.ospd.activity-type.terrain-and-hydrology>,
        <bblocks://ogc.ospd.activity-type.vector-geometry-processing>,
        <bblocks://ogc.ospd.activity-type.workflow-and-scoring> ;
    skos:prefLabel "Building Blocks - OSPD Activity Types" ;
    prof:hasResource [ rdfs:label "This Building Blocks Register in JSON-LD format" ;
            dct:type "application/ld+json" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
